# Kudla Route — environment configuration
#
# How to use: copy this file to .env and uncomment/set the values you need.
# .env is NOT loaded automatically — set variables in your shell, PM2 config,
# or systemd unit file. See docs/operations/deployment.md for details.
#
# (If you add dotenv in future: require("dotenv").config() at the top of index.js)

# TCP port the server listens on (default: 3000)
# PORT=3000

# Optional Node/Express environment setting. The app does not load .env files
# or require NODE_ENV for its API error handling.
# NODE_ENV=production

# TRUST_PROXY: set when the app runs behind a reverse proxy (nginx, Caddy).
# Without this, the rate limiter keys on the proxy's IP, so all users share
# one bucket. Valid values:
#   false    — default; use the direct peer address
#   1        — one trusted proxy hop; block untrusted direct access to Node
#   loopback — allow 127.0.0.1 / ::1 as trusted proxy IPs
# TRUST_PROXY=1
